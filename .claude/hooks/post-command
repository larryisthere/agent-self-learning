#!/usr/bin/env bash

# This script is a weak CLI reminder hook for AI Assistants (like Claude Code).
# It checks if there are uncommitted or untracked changes in the git repository.
# If changes exist, it gently reminds the developer (or the AI) to document what they learned.

git_dir="$(git rev-parse --git-dir 2>/dev/null)"
if [ -z "$git_dir" ]; then
    exit 0 # Not a git repository, silently exit.
fi

has_changes=false

# Check for uncommitted modifications
if ! git diff --quiet HEAD 2>/dev/null; then
    has_changes=true
fi

# Check for untracked files
if [ -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ]; then
    has_changes=true
fi

if [ "$has_changes" = true ]; then
    echo ""
    echo -e "\033[96m💡 [Memory Guard]:\033[0m Detected code changes in the repository."
    echo -e "Did you learn a new architectural pattern or solve a tricky bug today?"
    echo -e "Consider running \033[93m'/memory_capture'\033[0m to log your experience before moving on."
    echo ""
fi

exit 0
